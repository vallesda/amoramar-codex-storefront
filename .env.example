# Dominio permanente, sin https:// ni barra final.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Token PUBLICO de Storefront; se usa exclusivamente en el servidor.
# No usar un token Admin ni un token privado con este header.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
NEXT_PUBLIC_SITE_URL=http://localhost:3001
